# Load environment variables for development
ifneq ("$(wildcard ../.env.development)","")
include ../.env.development
export $(shell sed 's/=.*//' ../.env.development)
endif
# Load GITHUB secrets if they exist
ifneq ("$(wildcard ../.env.github)","")
include ../.env.github
export $(shell sed 's/=.*//' ../.env.github)
endif

service_name = flip-api
lint_command = uv run ruff check . --fix
test_args = --tb=short --disable-warnings --cov=src/ --cov-report=term-missing
test_coverage_html_command = uv run pytest $(test_args) --cov-report=html --cov-report=xml:coverage.xml
test_coverage_html_command_unit = uv run pytest ./tests/unit ./tests/step_functions_services $(test_args) --cov-report=html:htmlcov-unit --cov-report=xml:coverage-unit.xml
test_coverage_html_command_integration = uv run pytest ./tests/integration $(test_args) --cov-report=html:htmlcov-integration --cov-report=xml:coverage-integration.xml
docker_command = DEBUG=$(DEBUG) docker compose -f ../deploy/compose.development.yml
run_clean = run --rm --remove-orphans
mypy_command = uv run mypy . --ignore-missing-imports

up:
# Note we need to start the db first
	@echo "🚀 Starting flip-db..."
	$(docker_command) up --remove-orphans -d flip-db
	@echo "🚀 Starting $(service_name)..."
	$(docker_command) up --remove-orphans $(service_name)
down:
# Also kill the db
	@echo "🛑 Stopping $(service_name) ..."
	$(docker_command) down --remove-orphans $(service_name)
	@echo "🛑 Stopping flip-db ..."
	$(docker_command) down --remove-orphans flip-db
shell:
	$(docker_command) $(run_clean) $(service_name) /bin/bash
lint:
	$(docker_command) $(run_clean) $(service_name) $(lint_command)
mypy:
	$(docker_command) $(run_clean) $(service_name) $(mypy_command)
test:
	$(docker_command) $(run_clean) $(service_name) $(lint_command) && $(mypy_command) && $(test_coverage_html_command)
local_lint:
	$(lint_command)
local_mypy:
	$(mypy_command)
local_test:
	$(lint_command) && $(mypy_command) && $(test_coverage_html_command) --skip-client --skip-db
unit_test:
	$(lint_command) && $(mypy_command) && $(test_coverage_html_command_unit) --skip-client
# Integration tests boot a throwaway Postgres via Testcontainers (see
# tests/integration/conftest.py). --skip-client stays so the AWS-Cognito tests
# (out of scope for B1, see tests/integration/test_user_registration_real_api.py)
# don't try to call boto3.
integration_test:
	$(lint_command) && $(mypy_command) && $(test_coverage_html_command_integration) --skip-client
build:
	$(docker_command) build $(service_name)
restart: down up
debug:
	@echo "🚨 Starting debug mode..."
	@echo "🚨 Setting DEBUG=true"
	$(docker_command) restart --remove-orphans $(service_name)
# --- Database migrations (Alembic) ---
# Run inside the flip-api service container (same pattern as lint/test). The
# entrypoint already runs `alembic upgrade head` at boot; these are for manual
# use. `migration` autogenerates a revision by diffing the models against the
# live flip-db and writes it to src/flip_api/db/migrations/versions/ via the
# bind mount, so flip-db must be up and at head first (run `make up`). Always
# review the autogenerated file (native enums + ARRAY column) before committing.
migrate:
	$(docker_command) $(run_clean) $(service_name) uv run alembic upgrade head
migration:
	$(docker_command) $(run_clean) $(service_name) uv run alembic revision --autogenerate -m "$(MESSAGE)"
migration_downgrade:
	$(docker_command) $(run_clean) $(service_name) uv run alembic downgrade -1
migration_history:
	$(docker_command) $(run_clean) $(service_name) uv run alembic history
migration_current:
	$(docker_command) $(run_clean) $(service_name) uv run alembic current
create_testing_projects:
	@echo "🔢 Creating projects for debugging..."
	env DB_HOST=localhost uv run python -m tests.debug_prelaunch_task
delete_testing_projects:
	@echo "🔢 Removing projects created for debugging..."
	env DB_HOST=localhost uv run python -m tests.debug_post_debug_task
# Curated radiology catalogue in honest lifecycle states so a fresh platform
# doesn't look empty. Cleanup: EXTRA_ARGS="--cleanup".
seed_demo_projects:
	@echo "🌱 Seeding the demo radiology project catalogue..."
	env DB_HOST=localhost uv run python -m tests.seed_demo_projects $(EXTRA_ARGS)
# Provision the demo Cognito users for the demo-video recorder. Passwords
# come from DEMO_RESEARCHER_PASSWORD / DEMO_ADMIN_PASSWORD in the env.
create_demo_users:
	uv run python -m flip_api.scripts.create_demo_users
# Record the end-to-end demo video against the running dev stack (Dockerised
# Cypress segments + off-camera waits + ffmpeg assembly). Args via DEMO_ARGS,
# e.g. DEMO_ARGS="--skip-xnat" or DEMO_ARGS="--project-id <uuid> --from-segment 4".
demo_video:
	@echo "🎬 Recording the end-to-end demo video..."
	env DB_HOST=localhost uv run python -m tests.demo_video $(DEMO_ARGS)
# End-to-end smoke against a running `make up` stack: creates a project, gets
# it approved, uploads model files, waits for image pull, kicks off training,
# waits for results, downloads them. Intended for PR sanity checks — replaces
# the manual UI clickthrough.
#
# Defaults pick the chest-xray tutorial that matches FL_BACKEND so the same
# `make e2e_smoke` invocation works against either stack. Both tutorials are
# now in-tree under fl-tutorials/<backend>/ (NVFLARE at fl-tutorials/nvflare/,
# Flower at fl-tutorials/flower/). Both reuse the same query.sql
# against the trust mock OMOP data. Default backend matches
# deploy/fl_backend.mk (nvflare). Override either path explicitly:
#     make e2e_smoke MODEL_FILES_DIR=/path/to/app_files
#     make e2e_smoke QUERY_FILE=/path/to/your_cohort.sql
# Anything else passed via EXTRA_ARGS goes straight to the script:
#     make e2e_smoke EXTRA_ARGS="--image-pull-threshold 0.5"
FL_BACKEND ?= nvflare
ifeq ($(FL_BACKEND),flower)
MODEL_FILES_DIR ?= ../fl-tutorials/flower/xray_classification/app
QUERY_FILE ?= ../fl-tutorials/flower/xray_classification/query.sql
else
MODEL_FILES_DIR ?= ../fl-tutorials/nvflare/image_classification/xray_classification/app_files
QUERY_FILE ?= $(MODEL_FILES_DIR)/../query.sql
endif
e2e_smoke:
	@echo "🚀 Running e2e smoke (model files: $(MODEL_FILES_DIR), query: $(QUERY_FILE))..."
	env DB_HOST=localhost uv run python -m tests.e2e_smoke --model-files-dir "$(MODEL_FILES_DIR)" --query-file "$(QUERY_FILE)" $(EXTRA_ARGS)

# Spleen-segmentation variant of e2e_smoke: same recipe, with the spleen tutorial
# defaults plus a data-enrichment step that uploads segmentation labels to each
# trust's XNAT between image pull and training. Target-specific vars override the
# e2e_smoke defaults; e2e_smoke runs as a prerequisite with this target's vars applied.
#
# Segmentation apps need this step: the trust PACS supplies CT images only, while the
# spleen apps pair each converted input_*.nii.gz with a sibling label_*.nii.gz. Skip it
# and training dies with "No image/label pairs found" after a full pull cycle.
#
# Prereqs: the MSD labels downloaded locally (`make -C fl-tutorials download-spleen-data
# NUM_CASES=41`) and XNAT credentials for the trust in the environment (XNAT_HOST /
# XNAT_USER / XNAT_PASS). The accession-to-case mapping is fetched at run time from the
# public aicentreflip/trust-data dataset, so no private repo is required (FLIP#776).
# Absolute paths: the command runs with cwd=SPLEEN_ENRICHMENT_CWD (four levels below the repo
# root), so relative paths written from flip-api/ would not resolve there.
SPLEEN_ENRICHMENT_CWD := ../fl-tutorials/nvflare/image_segmentation/3d_spleen_segmentation
SPLEEN_ENRICHMENT_CMD := uv run --no-project --with $(abspath ../flip-utils) python utils/upload_spleen_labels_to_xnat.py --flip-project-id $$FLIP_PROJECT_ID --labels-dir $(abspath ../fl-tutorials/nvflare/data/spleen/images)

e2e_smoke_spleen: MODEL_FILES_DIR := ../fl-tutorials/flower/3d_spleen_segmentation/app
e2e_smoke_spleen: QUERY_FILE := ../fl-tutorials/flower/3d_spleen_segmentation/query.sql
e2e_smoke_spleen: EXTRA_ARGS := --data-enrichment-cwd $(SPLEEN_ENRICHMENT_CWD) --data-enrichment-cmd '$(SPLEEN_ENRICHMENT_CMD)'
e2e_smoke_spleen: e2e_smoke

# Spleen-segmentation evaluation variant of e2e_smoke_spleen: same cohort query
# and same data-enrichment step, but uploads the evaluation tutorial's app dir
# instead of the training one. That dir bundles a pre-trained model.pt
# alongside the code -- the e2e smoke uploads it as part of the model files;
# the fl-api writes it into /app/src/<model_id>/app/ on the shared FL_JOBS_DIR
# mount; the evaluation ServerApp reads it via flip-job-dir at submit time.
e2e_smoke_spleen_evaluation: MODEL_FILES_DIR := ../fl-tutorials/flower/3d_spleen_segmentation_evaluation/app
e2e_smoke_spleen_evaluation: QUERY_FILE := ../fl-tutorials/flower/3d_spleen_segmentation/query.sql
e2e_smoke_spleen_evaluation: EXTRA_ARGS := --data-enrichment-cwd $(SPLEEN_ENRICHMENT_CWD) --data-enrichment-cmd '$(SPLEEN_ENRICHMENT_CMD)'
e2e_smoke_spleen_evaluation: e2e_smoke

generate-internal-service-key:
	uv run python -m flip_api.scripts.generate_internal_service_key $(if $(ENV_FILE),--env-file $(ENV_FILE)) $(if $(FORCE),--force)
generate-xnat-credentials:
	uv run python -m flip_api.scripts.generate_xnat_credentials $(if $(ENV_FILE),--env-file $(ENV_FILE)) $(if $(FORCE),--force)
