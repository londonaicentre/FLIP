//
// Multi-root workspace for the FLIP monorepo. Each Python sub-project is its own folder so
// Pylance uses that folder's `.venv` (e.g. nvflare imports resolve in fl-api-base) and Ruff
// uses that folder's `pyproject.toml` config — driven by each folder's `.vscode/settings.json`.
// A single-root workspace opened at the repo top can't do this: it applies only the top-level
// `.vscode/settings.json`, which pins one interpreter (flip-api) and one ruff config for
// everything. Open via: File > Open Workspace from File…  (the most-specific folder wins, so
// the root folder below is just for top-level docs/deploy/scripts).
{
    "folders": [
        { "path": "flip-api" },
        { "path": "flip-utils" },
        { "path": "fl-services/nvflare/fl-api-base" },
        { "path": "fl-services/flower/fl-api-flower" },
        { "path": "trust/trust-api" },
        { "path": "trust/imaging-api" },
        { "path": "trust/data-access-api" },
        { "path": "flip-ui" },
        { "path": "deploy/providers/AWS" },
        { "name": "FLIP (root: docs, deploy, fl-apps, fl-tutorials, scripts)", "path": "." }
    ]
}
