XNAT_VERSION=1.9.3
# Heap raised from 1024m/3072m: bulk DQR imports drove G1 GC pressure that, with
# the Reactor EventBus back-pressure livelock, helped wedge large cohort pulls
# (FLIP#662). Trust hosts have ample RAM; 2g/8g gives GC headroom for big imports.
XNAT_MIN_HEAP=2048m
XNAT_MAX_HEAP=8192m
XNAT_SMTP_ENABLED=false
XNAT_SMTP_HOSTNAME=fake.fake
XNAT_SMTP_PORT=
XNAT_SMTP_AUTH=
XNAT_SMTP_USERNAME=
XNAT_SMTP_PASSWORD=
# Passwords (XNAT_DATASOURCE_PASSWORD, XNAT_DATASOURCE_ADMIN_PASSWORD,
# XNAT_ACTIVEMQ_PASSWORD) are per-trust secrets and deliberately NOT in this
# committed file: they live in the trust's kit file (trust/.env.<CODE>.<env>),
# minted automatically by `make register-trust` (or on demand with
# `make generate-xnat-credentials`), and are loaded into the containers as
# runtime environment only — never baked into the published image.
# The usernames below are non-secret connection config and may stay as-is.
XNAT_DATASOURCE_USERNAME=xnat
XNAT_ACTIVEMQ_USERNAME=write
XNAT_DATASOURCE_DRIVER=org.postgresql.Driver
XNAT_DATASOURCE_NAME=xnat
XNAT_DATASOURCE_URL=jdbc:postgresql://xnat-db/xnat
XNAT_ACTIVEMQ_URL=tcp://xnat-activemq:61616
TOMCAT_XNAT_FOLDER=ROOT
XNAT_ROOT=/data/xnat
XNAT_HOME=/data/xnat/home
XNAT_EMAIL=email@gstt.nhs.uk

PG_VERSION=12.2-alpine

NGINX_VERSION=1.30.1-alpine-perl
