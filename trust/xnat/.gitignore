# Created by .ignore support plugin (hsz.mobi)
*.swo
*.swp

# Ignore Gradle project-specific cache directory
.gradle/

# Ignore build manifests
manifest*.json

# Ignore gradle.properties to allow setting persistent property overrides
gradle.properties

# Ignore log and env files, as well as mounted data folders and plugin folders.
*.log
*-data/
xnat/plugins/*.jar
# Stamp left by the old S3-synced plugin cache (FLIP#1292). `fetch` removes it, but `make up` only
# checks the cache, so a warm cache keeps it until the next prepare-artifacts. Drop after a release.
xnat/plugins/.s3-prefix
xnat/plugins/.*.part
xnat/build-artifacts/.*.part
xnat/build-artifacts/*.war

xnat/webapps
