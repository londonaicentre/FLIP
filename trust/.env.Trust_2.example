# Per-trust config + kit file for the Trust_2 slot.
#
# trust/Makefile selects this kit with `make up-trust KIT=Trust_2`, which
# `-include`s trust/.env.Trust_2. Copy this template to that path (drop the
# .example suffix) for a dev trust-2 stack:
#     cp trust/.env.Trust_2.example trust/.env.Trust_2
#
# Two parts:
#   1. Host-local profile (ports, bind dirs) — unsuffixed names read straight
#      into the compose stack. These values are offset from the Trust_1
#      allocation so a trust-1 and trust-2 stack can run side by side on one
#      host. Edit only to avoid a port clash.
#   2. Kit credentials — minted by the hub. Filled in automatically by
#      `make register-deploy-trusts` (which upserts the five keys below), or
#      by hand from the Add-Trust modal (POST /admin/trusts shows the plaintext
#      once). The hub stores only the SHA-256 hash of TRUST_API_KEY.
#
# The real trust/.env.Trust_2 is gitignored (it holds plaintext secrets);
# this .example template is tracked.

# ── Host-local profile ────────────────────────────────────────────────────
OMOP_DB_PORT=5436
PACS_UI_PORT=8044
XNAT_PORT=8106
ORTHANC_STORAGE_DIR=./orthanc/orthanc-storage-2
BASE_IMAGES_DOWNLOAD_DIR=./data/Trust_2
TRUST_DEBUG_PORT=5685
IMAGING_DEBUG_PORT=5684
DATA_ACCESS_DEBUG_PORT=5683
GRAFANA_PORT=3001
LOKI_PORT=3101

# ── Kit credentials ───────────────────────────────────────────────────────
# `make register-deploy-trusts` upserts these five keys. EXPECTED_TRUST_ID is
# an opt-in self-check: if the hub resolves this host's API key to a different
# trust id, the trust-api exits instead of silently acting as the wrong trust.
TRUST_API_KEY=<from register-deploy-trusts / Add-Trust modal>
TRUST_INTERNAL_SERVICE_KEY=<from register-deploy-trusts / Add-Trust modal>
FL_KIT_SLOT=<from register-deploy-trusts / Add-Trust modal>
FL_KIT_SLOT_NUMBER=<from register-deploy-trusts / Add-Trust modal>
EXPECTED_TRUST_ID=<from register-deploy-trusts / Add-Trust modal>
