# Dev example kit for the GSTT trust. `make up` (dev) seeds
# trust/.env.GSTT.development from this, then `make register-trust KIT=GSTT`
# registers it on the hub (claiming the next free FL kit slot) and fills the
# managed blocks. Distinct host ports from the KCH dev kit so both can run on
# one host. The live file is gitignored; this .example is tracked.

# ── Trust identity (sent to the hub by `make register-trust`) ──
TRUST_NAME=Guy's and St Thomas' Trust
TRUST_CODE=GSTT
TRUST_REGION=London

# ── Host-local profile ────────────────────────────────────────────────────
OMOP_DB_PORT=5434
PACS_UI_PORT=8042
XNAT_PORT=8104
TRUST_DEBUG_PORT=5682
IMAGING_DEBUG_PORT=5681
DATA_ACCESS_DEBUG_PORT=5680
GRAFANA_PORT=3000
LOKI_PORT=3100

# Orthanc storage (seeded DICOM). Set arbitrarily to a populated dir — dev mock
# DICOM lives under orthanc/orthanc-storage-trust<N>. Decoupled from the CODE.
ORTHANC_STORAGE_DIR=./orthanc/orthanc-storage-trust1
BASE_IMAGES_DOWNLOAD_DIR=./data/GSTT
XNAT_DATA_DIR=./xnat-data-GSTT
FL_KIT_DIR=/opt/flip/fl-kit
AICENTRE_BUCKET_NAME=flipdev-aicentre
# OMOP DB data dir (a postgres-initialised dir). Set arbitrarily to any populated
# dir — dev mock data lives under omop-db/volumes/Trust_<N>. Decoupled from the
# trust CODE so a new trust can reuse existing seeded data.
OMOP_DATA_DIR=./omop-db/volumes/Trust_1/db_data

# ── Trust-local credentials (mock-stack defaults; swap for real secrets in prod) ──
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=admin

OMOP_POSTGRES_USER=postgres
OMOP_POSTGRES_PASSWORD=omop
OMOP_POSTGRES_DB=trustomopdb
# OMOP_DB_TAG=            # unset → DOCKER_TAG, as for the other trust images

DATA_ACCESS_POSTGRES_USER=data_analyst_reader
DATA_ACCESS_POSTGRES_PASSWORD=change_me_analyst_secure_password

XNAT_ADMIN_USER=admin
XNAT_ADMIN_INITIAL_PASSWORD=admin
XNAT_ADMIN_PASSWORD=admin
XNAT_SERVICE_USER=flipServiceAccount
XNAT_SERVICE_PASSWORD=flip

# Internal trust-network URLs + service-auth header name. Kept in the kit
# because the fl-client also reads them from env; the trust
# APIs additionally default these in code, so they are robust if a kit omits them.
DATA_ACCESS_API_URL=http://data-access-api:8000
IMAGING_API_URL=http://imaging-api:8000
TRUST_INTERNAL_SERVICE_KEY_HEADER=X-Trust-Internal-Service-Key

GRAFANA_ADMIN_PASSWORD=admin

PACS_DICOM_PORT=4242

POLL_INTERVAL_SECONDS=5

DATA_ACCESS_API_PORT=8010
IMAGING_API_PORT=8001
TRUST_API_PORT=8020

TRUST_LOG_LEVEL=DEBUG

NUM_AVAILABLE_GPUS=1
MEMORY_PER_GPU_IN_GIB=7
MIN_CLIENTS=1

# ── Hub-shared (managed by register-trust / sync-trust-kits — do not edit) ──
# (dev) inherited from the hub's .env.development (the single source) — left commented to avoid a drifting copy. Production kits set these live.
# AES_KEY_BASE64=
# CENTRAL_HUB_API_URL=
# TRUST_API_KEY_HEADER=
# FL_BACKEND=
# FLOWER_KIT_DATE=
# FLARE_KIT_DATE=
# DOCKER_TAG=
# DOCKER_REGISTRY=
# DOCKER_FL_TAG=
# DOCKER_FL_REGISTRY=
# NLB_SUBDOMAIN=
# FL_SERVER_PORT=

# ── Kit credentials (managed) ─────────────────────────────────────────────
TRUST_API_KEY=<run-make-register-trust>
TRUST_INTERNAL_SERVICE_KEY=<run-make-register-trust>
FL_KIT_SLOT=<run-make-register-trust>
FL_KIT_SLOT_NUMBER=<run-make-register-trust>
EXPECTED_TRUST_ID=<run-make-register-trust>
