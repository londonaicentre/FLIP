# Per-trust config + kit file for the Trust_1 slot.
#
# trust/Makefile `-include`s trust/.env.Trust_1 — copy this template to that
# path (drop the .example suffix) for a dev trust-1 stack:
#     cp trust/.env.Trust_1.example trust/.env.Trust_1
#
# Two parts:
#   1. Host-local profile (ports, bind dirs) — static dev defaults, suffixed
#      `_TRUST_1` so a trust-1 and trust-2 stack can run side by side on one
#      host without colliding. Edit only to avoid a port clash.
#   2. Kit credentials — minted by the hub. Filled in automatically by
#      `make register-deploy-trusts` (which upserts the five keys below), or
#      by hand from the Add-Trust modal (POST /admin/trusts shows the plaintext
#      once). The hub stores only the SHA-256 hash of TRUST_API_KEY.
#
# The real trust/.env.Trust_1 is gitignored (it holds plaintext secrets);
# this .example template is tracked.

# ── Host-local profile ────────────────────────────────────────────────────
PACS_UI_PORT_TRUST_1=8042
OMOP_DB_PORT_TRUST_1=5434
XNAT_PORT_TRUST_1=8104
ORTHANC_STORAGE_DIR_TRUST_1=./orthanc/orthanc-storage
BASE_IMAGES_DOWNLOAD_DIR_TRUST1=./data/Trust_1
TRUST_DEBUG_PORT_TRUST_1=5682
IMAGING_DEBUG_PORT_TRUST_1=5681
DATA_ACCESS_DEBUG_PORT_TRUST_1=5680
GRAFANA_PORT_TRUST_1=3000
LOKI_PORT_TRUST_1=3100

# ── Kit credentials ───────────────────────────────────────────────────────
# `make register-deploy-trusts` upserts these five keys. EXPECTED_TRUST_ID is
# an opt-in self-check: if the hub resolves this host's API key to a different
# trust id, the trust-api exits instead of silently acting as the wrong trust.
TRUST_API_KEY=<from register-deploy-trusts / Add-Trust modal>
TRUST_INTERNAL_SERVICE_KEY=<from register-deploy-trusts / Add-Trust modal>
FL_KIT_SLOT=<from register-deploy-trusts / Add-Trust modal>
FL_KIT_SLOT_NUMBER=<from register-deploy-trusts / Add-Trust modal>
EXPECTED_TRUST_ID=<from register-deploy-trusts / Add-Trust modal>
