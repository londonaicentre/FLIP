# Per-trust config + kit file for the Trust_1 slot.
#
# trust/Makefile selects this kit with `make up-trust KIT=Trust_1`, which
# `-include`s trust/.env.Trust_1. Copy this template to that path (drop the
# .example suffix) for a dev trust-1 stack:
#     cp trust/.env.Trust_1.example trust/.env.Trust_1
#
# Four sections, in order:
#   1. Host-local profile — unsuffixed ports / bind dirs read straight into
#      the compose stack. Operator-owned, hand-edited. These values are the
#      Trust_1 allocation and also the defaults baked into trust/Makefile's
#      TRUST_VARS, so a single-trust host could omit them; a second dev stack
#      (Trust_2) must override them so the two stacks don't collide on host
#      ports.
#   2. Trust-local credentials — Orthanc / OMOP / XNAT / Grafana passwords
#      and trust-internal service URLs. Operator-owned, hand-edited. Never
#      leave the trust environment — the hub does not see these values.
#   3. Hub-shared (managed) — values the hub admin owns. Filled in by
#      `make register-trust-1` on initial registration, refreshed by
#      `make sync-trust-kit-1` after a hub-side change (AES_KEY_BASE64
#      rotation, DOCKER_TAG bump, FL_BACKEND switch, etc.).
#   4. Kit credentials (managed) — minted by the hub via
#      `make register-trusts` (write-once: the hub stores only the SHA-256
#      hash of TRUST_API_KEY, so credentials cannot be re-emitted on rerun).
#
# The real trust/.env.Trust_1 is gitignored (it holds plaintext secrets);
# this .example template is tracked.

# ── Host-local profile ────────────────────────────────────────────────────
OMOP_DB_PORT=5434
PACS_UI_PORT=8042
XNAT_PORT=8104
TRUST_DEBUG_PORT=5682
IMAGING_DEBUG_PORT=5681
DATA_ACCESS_DEBUG_PORT=5680
GRAFANA_PORT=3000
LOKI_PORT=3100

ORTHANC_STORAGE_DIR=./orthanc/orthanc-storage-trust1
BASE_IMAGES_DOWNLOAD_DIR=./data/Trust_1
# XNAT bind-mount parent dir. Relative paths resolve from trust/xnat/.
# In stag/prod set this to the host path Ansible provisioned (e.g.
# /opt/flip/xnat). trust/xnat/Makefile resolves whatever you set here to
# an absolute path before exporting to docker compose.
XNAT_DATA_DIR=./xnat-data-trust1
# TODO: remove once OMOP / Orthanc test-data fixtures are no longer pulled
# from the hub-side dev S3 bucket. trust/omop-db/update_omop_data.sh and
# trust/orthanc/update_orthanc_data.sh require AICENTRE_BUCKET_NAME; with
# the kit-file refactor the trust sub-make no longer inherits it from the
# hub .env.development, so we surface it here as a temporary opt-in.
AICENTRE_BUCKET_NAME=flipdev-aicentre

# ── Trust-local credentials ──────────────────────────────────────────────
# Per-trust secrets the operator owns. The defaults below are dev-friendly
# and identical across Trust_1/Trust_2/Trust_Local so `make up` from the
# repo root brings both trusts up without further editing. In prod each
# trust operator must swap these for real secrets. These are NOT in the
# hub's .env file — they live only in this kit file, so a remote trust
# operator can start their stack without needing the hub's environment.

# Orthanc (DICOM / PACS)
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=admin

# OMOP service account
OMOP_DB_SERVICE_NAME=omop-db
OMOP_POSTGRES_USER=postgres
OMOP_POSTGRES_PASSWORD=omop
OMOP_POSTGRES_DB=trustomopdb
OMOP_DB_TAG=latest

# OMOP read-only user used by data-access-api for cohort queries.
DATA_ACCESS_POSTGRES_USER=data_analyst_reader
DATA_ACCESS_POSTGRES_PASSWORD=change_me_analyst_secure_password

# XNAT admin + service account
XNAT_ADMIN_USER=admin
XNAT_ADMIN_INITIAL_PASSWORD=admin
XNAT_ADMIN_PASSWORD=admin
XNAT_SERVICE_USER=flipServiceAccount
XNAT_SERVICE_PASSWORD=flip
XNAT_DATABASE_URL=postgresql+asyncpg://xnat:xnat@xnat-db:5432/xnat

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Service URLs internal to the trust Docker network (rarely overridden).
DATA_ACCESS_API_URL=http://data-access-api:8000
IMAGING_API_URL=http://imaging-api:8000
XNAT_URL=http://xnat-web:8080

# Trust-internal service-auth header name. Must match what trust-api,
# imaging-api, data-access-api, and fl-client all read.
TRUST_INTERNAL_SERVICE_KEY_HEADER=X-Trust-Internal-Service-Key

# PACS DICOM listening port + per-PACS index.
PACS_DICOM_PORT=4242
PACS_ID=1

# trust-api -> hub poll cadence (seconds).
POLL_INTERVAL_SECONDS=5

# Host-facing trust-API ports.
DATA_ACCESS_API_PORT=8010
IMAGING_API_PORT=8001
TRUST_API_PORT=8020

# Trust service log level.
TRUST_LOG_LEVEL=DEBUG

# fl-client capacity hints — these describe THIS trust, not hub policy.
NUM_AVAILABLE_GPUS=1
MEMORY_PER_GPU_IN_GIB=7
MIN_CLIENTS=1

# Synced from the hub by `make register-trust-1` (initial registration) or
# `make sync-trust-kit-1` (refresh without rotating credentials). These
# values must match the hub's own configuration — the operator does not
# choose them. Re-sync after the hub admin rotates AES_KEY_BASE64, bumps
# DOCKER_TAG, switches FL_BACKEND, etc. Keep the key list in lockstep with
# HUB_SHARED_ENV_KEYS in flip_api/scripts/register_trust.py.
#
# `<run-make-sync-trust-kit>` means register/sync has not populated this
# kit yet; the trust stack will refuse to start until it is filled in.
# The header line below is a sentinel — distribute-trust-kits.sh and
# sync-trust-kits.sh both grep for it byte-for-byte; do not edit.
# ── Hub-shared (managed by register-trust / sync-trust-kits — do not edit) ──
AES_KEY_BASE64=<run-make-sync-trust-kit>
CENTRAL_HUB_API_URL=<run-make-sync-trust-kit>
TRUST_API_KEY_HEADER=<run-make-sync-trust-kit>
FL_BACKEND=<run-make-sync-trust-kit>
FLARE_KIT_DATE=<run-make-sync-trust-kit>
FLOWER_KIT_DATE=<run-make-sync-trust-kit>
DOCKER_TAG=<run-make-sync-trust-kit>
DOCKER_REGISTRY=<run-make-sync-trust-kit>
DOCKER_FL_TAG=<run-make-sync-trust-kit>
DOCKER_FL_REGISTRY=<run-make-sync-trust-kit>
DOCKER_FL_CLIENT_NAME=<run-make-sync-trust-kit>
UPLOADED_FEDERATED_DATA_BUCKET=<run-make-sync-trust-kit>
NLB_SUBDOMAIN=<run-make-sync-trust-kit>
FL_SERVER_PORT=<run-make-sync-trust-kit>

# ── Kit credentials (managed) ─────────────────────────────────────────────
# `make register-trusts` upserts these five keys. EXPECTED_TRUST_ID is
# an opt-in self-check: if the hub resolves this host's API key to a different
# trust id, the trust-api exits instead of silently acting as the wrong trust.
TRUST_API_KEY=<run-make-register-trusts>
TRUST_INTERNAL_SERVICE_KEY=<run-make-register-trusts>
FL_KIT_SLOT=<run-make-register-trusts>
FL_KIT_SLOT_NUMBER=<run-make-register-trusts>
EXPECTED_TRUST_ID=<run-make-register-trusts>
