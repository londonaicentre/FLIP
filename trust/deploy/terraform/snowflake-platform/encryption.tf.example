#
# OpenTofu state encryption for the test account's local state (FLIP#1581).
#
# Copy to encryption.tf (gitignored) and export the passphrase before any `make` target:
#
#   cp encryption.tf.example encryption.tf
#   export TF_ENCRYPTION_PASSPHRASE="$(read from your password manager)"
#
# The whole block can instead be supplied through the TF_ENCRYPTION environment variable, which
# keeps the passphrase out of the working tree entirely:
#
#   export TF_ENCRYPTION='key_provider "pbkdf2" "state" { passphrase = "..." }
#     method "aes_gcm" "state" { keys = key_provider.pbkdf2.state }
#     state { method = method.aes_gcm.state }'
#
# Either way the passphrase is never a Terraform variable and never reaches state or a plan file.

terraform {
  encryption {
    key_provider "pbkdf2" "state" {
      passphrase = env("TF_ENCRYPTION_PASSPHRASE")
    }

    method "aes_gcm" "state" {
      keys = key_provider.pbkdf2.state
    }

    state {
      method = method.aes_gcm.state
      # Refuse to read or write unencrypted state once encryption is configured.
      enforced = true
    }

    plan {
      method   = method.aes_gcm.state
      enforced = true
    }
  }
}
