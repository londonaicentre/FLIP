terraform {
  required_version = ">= 1.13.1"

  # Bucket, key and region are passed at `terraform init` by the Makefile (STATE_BUCKET=,
  # STATE_KEY=). The state never lives in the hub's: a site keeps it in its own account.
  backend "s3" {
    encrypt      = true
    use_lockfile = true
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = merge(var.tags, {
      project = "flip"
      purpose = "aws-trust-node"
      trust   = var.name
    })
  }
}
