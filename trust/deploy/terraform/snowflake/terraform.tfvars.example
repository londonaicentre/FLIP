# Copy to terraform.tfvars (gitignored) and fill in. No real account identifier, organization name
# or key is ever committed: every value below is a placeholder.

organization_name = "MYORG"
account_name      = "MYACCOUNT"

# The workload root is always applied as the deploy role. The deploy user, the role and the four
# account privileges it holds are created by ../snowflake-platform.
terraform_role      = "FLIP_GSTT_DEPLOY"
# terraform_warehouse: leave unset; the provider needs no warehouse and FLIP_<CODE>_WH is created by this root

trust_code = "GSTT"

# Cost guards. The credit quota lives in the platform root; this root attaches that monitor.
warehouse_statement_timeout_secs = 300
pool_auto_suspend_secs           = 600
attach_resource_monitor          = true
suspend_pools_cron               = "0 22 * * *"
suspend_pools_timezone           = "Europe/London"

# Off on a trial account: no GPU quota, and trials exclude external network access.
enable_gpu_pool = false

# Set to true only when the platform root created FLIP_GSTT_HUB_EAI. This root creates no
# integration: it just reports the name for #1582's service specs.
enable_hub_egress = false

num_fl_nets = 1

# Placeholder until #1582 lands the SPCS service specs.
manage_services = false
