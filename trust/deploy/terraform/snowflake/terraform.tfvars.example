# Copy to terraform.tfvars (gitignored) and fill in. No real account identifier, organization name
# or key is ever committed: every value below is a placeholder.

organization_name = "MYORG"
account_name      = "MYACCOUNT"

# The role Terraform runs as. ACCOUNTADMIN only for the one-off bootstrap (see README.md).
terraform_role      = "FLIP_GSTT_ADMIN"
terraform_warehouse = "FLIP_GSTT_WH"

trust_code = "GSTT"

# The deploy SERVICE user's RSA public key: the base64 body only, no PEM header, footer or
# newlines. Generate with `openssl genrsa 2048 | openssl rsa -pubout`, keep the private half out
# of this repository.
deploy_user_public_key = "REPLACE_WITH_THE_PUBLIC_KEY_BODY"

# Cost guards.
warehouse_statement_timeout_secs = 300
pool_auto_suspend_secs           = 600
credit_quota                     = 50
suspend_pools_cron               = "0 22 * * *"
suspend_pools_timezone           = "Europe/London"

# Off on a trial account: no GPU quota, and trials exclude external network access.
enable_gpu_pool   = false
enable_hub_egress = false

# Only read when enable_hub_egress is true.
# hub_api_host        = "api.example.invalid"
# fl_server_endpoints = ["fl.example.invalid:8002", "fl.example.invalid:8003"]

# Sign-in allowlist for the account. Empty means no account network policy is attached.
# admin_allowed_cidrs = ["203.0.113.4/32"]

num_fl_nets = 1

# Placeholder until #1582 lands the SPCS service specs.
manage_services = false
