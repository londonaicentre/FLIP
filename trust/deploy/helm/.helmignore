# Helm stores the packaged chart in every release record, a Secret capped at 1 MiB. Ship only
# what a release renders from: Chart.yaml, the values files, templates/ and the config/ files
# the templates read with .Files.Get. Everything else here is for operators and CI.
.git/
.gitignore
.helmignore
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
# Operator and CI python at the chart root. config/*.py ships: the xnat-db migrate hook reads its
# scripts with .Files.Get, and a packaged chart has no checkout to fetch them from (FLIP#2071).
/check_status.py
/sync_k8s_kit.py
tests/
ci/
scripts/
# The image the CronJob runs is built from the repo root (docker_build_trust_upgrade_agent.yml),
# not packaged with the chart.
agent/
Makefile
*.md
values-override.yaml
values-aks.yaml
values-eks.yaml
values-small-node.yaml
values-secrets.yaml.example
# Generated by scripts/generate_values.py with live trust credentials: never in a packaged chart.
values-secrets.yaml
k8s-trust-*.yaml
*.tgz
.DS_Store
.vscode/
