{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "FLIP Trust Helm Chart Values",
  "description": "Schema for values.yaml of the flip-trust Helm chart",
  "type": "object",
  "additionalProperties": true,
  "required": ["trustName", "trustNumber"],
  "properties": {
    "trustName": {
      "type": "string",
      "description": "Name of the trust (e.g. Trust_1)"
    },
    "trustNumber": {
      "type": "integer",
      "minimum": 0,
      "description": "Numeric ID for the trust (0 reserved for non-numeric FL kit slots such as Trust_K8s)"
    },
    "environment": {
      "type": "string",
      "enum": ["production", "staging", "development"],
      "description": "Deployment environment"
    },
    "logLevel": {
      "type": "string",
      "description": "Application log level"
    },
    "awsRegion": {
      "type": "string",
      "description": "AWS region for S3 and other AWS-integrated services"
    },
    "flBackend": {
      "type": "string",
      "enum": ["nvflare", "flower"],
      "description": "FL backend selection"
    },
    "namespace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "existingName": { "type": "string" },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "trustApi": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "liveness": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
              }
            },
            "readiness": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "type": { "type": "string" }
          }
        }
      }
    },
    "imagingApi": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "liveness": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
              }
            },
            "readiness": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "type": { "type": "string" }
          }
        }
      }
    },
    "dataAccessApi": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "liveness": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
              }
            },
            "readiness": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "type": { "type": "string" }
          }
        }
      }
    },
    "flClient": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            }
          }
        },
        "gpu": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "count": { "type": "integer" }
          }
        }
      }
    },
    "omopDb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "vocabLoad": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "s3Bucket": { "type": "string" },
            "bundleName": { "type": "string" },
            "workDirSize": { "type": "string", "minLength": 1 },
            "fetchResources": { "type": "object", "minProperties": 1 },
            "loadResources": { "type": "object", "minProperties": 1 }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "orthanc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" },
                "cpu": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "xnat": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "web": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "resources": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object",
                  "properties": {
                    "memory": { "type": "string" },
                    "cpu": { "type": "string" }
                  }
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "memory": { "type": "string" },
                    "cpu": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "loki": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "alloy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "grafana": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer" },
        "maxReplicas": { "type": "integer" }
      }
    },
    "networkPolicies": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedEgressCIDRsWithPorts": {
          "type": "array",
          "description": "Egress rules combining CIDRs with a specific port (e.g. fl-server gRPC on 8002)",
          "items": {
            "type": "object",
            "required": ["cidrs", "port"],
            "properties": {
              "cidrs": { "type": "array", "items": { "type": "string" } },
              "port": { "type": "integer" },
              "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] }
            }
          }
        }
      }
    }
  }
}
