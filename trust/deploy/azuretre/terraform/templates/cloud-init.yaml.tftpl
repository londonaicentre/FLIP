#
# First boot of a FLIP node in an AzureTRE workspace (FLIP#1792). The bundle carries no copy of
# flip-node: this installs the one the pinned release ships (FLIP's Azure VM helper), then lets it
# mount the data disk, clone FLIP and run trust/deploy/ansible/azure.yml, as on FLIP's own Azure VM.
# node.env holds the settings flip-node reads. No secrets.
package_update: true
packages:
  - git
  - make
  - curl
  - unzip
  - python3
  - ansible-core
write_files:
  - path: /etc/flip/node.env
    permissions: "0644"
    content: |
      FLIP_REPO_URL=${repo_url}
      FLIP_REF=${ref}
      FLIP_ADMIN_USER=${admin_user}
      FL_BACKEND=${fl_backend}
      KIT_DROP_URL=${kit_drop_url}
  - path: /usr/local/sbin/flip-node-install
    permissions: "0755"
    content: |
      #!/bin/bash
      # Install the pinned release's flip-node.
      set -euo pipefail
      . /etc/flip/node.env
      src="$(mktemp -d)"
      git clone --quiet --depth 1 --branch "$FLIP_REF" "$FLIP_REPO_URL" "$src"
      install -m 0755 "$src/trust/deploy/terraform/azure/vm/templates/flip-node.sh" /usr/local/sbin/flip-node
      rm -rf "$src"
runcmd:
  - [/usr/local/sbin/flip-node-install]
  - [/usr/local/sbin/flip-node, provision]
