# Base trust kit template — `make new-trust` copies this and prepends the
# trust identity (TRUST_NAME / TRUST_CODE / TRUST_REGION) to
# produce trust/.env.<CODE>.<env>. `make register-trust KIT=<CODE> PROD=<env>`
# then fills the managed blocks (credentials, FL kit slot, hub-shared).
#
# Sections, in order:
#   1. Host-local profile — ports / bind dirs. Operator-owned. The defaults
#      below suit a single trust on its own host; co-tenant dev trusts on one
#      host need distinct ports (see the shipped .env.<CODE>.development.example
#      kits, which carry non-colliding allocations).
#   2. Trust-local credentials — mock-stack defaults, dev-friendly. In prod the
#      operator swaps these for real secrets. Never leave the trust environment.
#   3. Managed blocks — placeholders filled by `make register-trust`
#      (credentials + FL kit slot + hub-shared). `<run-make-register-trust>`
#      means the kit has not been registered yet; the stack refuses to start
#      until the placeholders are filled. `make sync-trust-kit` later refreshes
#      the hub-shared block without re-minting credentials.
#
# The live trust/.env.<CODE>.<env> is gitignored (plaintext secrets); this
# .example template is tracked.

# ── Host-local profile ────────────────────────────────────────────────────
OMOP_DB_PORT=5434
PACS_UI_PORT=8042
# XNAT_PORT is the DICOM SCP receiver port; XNAT_WEB_PORT is the host-published web UI. They were
# one variable until FLIP#993, which is why host 8104 served Tomcat while the DICOM receiver's 8104
# was an unpublished container port. Keep them equal unless connecting a real PACS: publishing the
# receiver (REAL_PACS=true) needs two distinct host ports.
XNAT_PORT=8104
XNAT_WEB_PORT=8104
TRUST_DEBUG_PORT=5682
IMAGING_DEBUG_PORT=5681
DATA_ACCESS_DEBUG_PORT=5680
GRAFANA_PORT=3000
LOKI_PORT=3100

# Orthanc storage (seeded DICOM). Point at a populated dir; dev mock DICOM lives
# under orthanc/orthanc-storage-trust<N>. Decoupled from the trust CODE.
ORTHANC_STORAGE_DIR=./orthanc/orthanc-storage-trust1
BASE_IMAGES_DOWNLOAD_DIR=./data/trust
XNAT_DATA_DIR=./xnat-data
# FL participant kit root on this host. The prod trust compose mounts
# ${FL_KIT_DIR}/net-1/services/${FL_KIT_SLOT}/{local,startup,transfer}
# (nvflare) or ${FL_KIT_DIR}/net-1/{certificates,keys} (flower). On an AWS EC2
# trust the Ansible playbook stages the kit at /opt/flip/fl-kit. Dev `make up`
# uses FL_PROVISIONED_DIR (sibling-repo workspace) and ignores this var.
FL_KIT_DIR=/opt/flip/fl-kit
# Dev OMOP / Orthanc test-data fixtures are pulled from the hub-side S3 bucket
# (trust/omop-db + trust/orthanc update scripts). Temporary opt-in.
AICENTRE_BUCKET_NAME=flipdev-aicentre
# OMOP DB data dir (a postgres-initialised dir). Set arbitrarily to a populated
# dir; leave unset to default to omop-db/volumes/Trust_<assigned-slot>/db_data.
# Decoupled from the trust CODE so a new trust can reuse existing seeded data.
#OMOP_DATA_DIR=./omop-db/volumes/Trust_1/db_data

# ── Trust-local credentials ──────────────────────────────────────────────
# Per-trust secrets the operator owns. Dev-friendly mock-stack defaults; swap
# for real secrets in prod. NOT in the hub's .env — live only in this kit.

# Orthanc (DICOM / PACS) — HTTP basic-auth login for the mock PACS UI.
# Dev-mock defaults; change for any shared deployment (see trust/orthanc/README.md).
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=admin

# OMOP service account
OMOP_POSTGRES_USER=postgres
OMOP_POSTGRES_PASSWORD=omop
OMOP_POSTGRES_DB=trustomopdb

# omop-db image tag. Unset → DOCKER_TAG, like every other trust image. Set it
# only to pin omop-db at a known-good tag while the rest of the stack runs a
# different one (omop-db branch builds are workflow_dispatch only).
# OMOP_DB_TAG=

# OMOP read-only user used by data-access-api for cohort queries.
DATA_ACCESS_POSTGRES_USER=data_analyst_reader
DATA_ACCESS_POSTGRES_PASSWORD=change_me_analyst_secure_password

# Minimum cohort size this trust will release anything about. Cohort statistics below it
# are privacy-suppressed, and both row-level routes (/cohort/dataframe for FL training data,
# /cohort/accession-ids for the imaging pull) refuse outright. Raise it to release less;
# this is the trust's own disclosure floor, not a hub setting. Must be a positive integer —
# 0 would disable all three checks, so it is rejected and the service refuses to start.
COHORT_QUERY_THRESHOLD=10

# XNAT admin + service account
XNAT_ADMIN_USER=admin
XNAT_ADMIN_INITIAL_PASSWORD=admin
XNAT_ADMIN_PASSWORD=admin
XNAT_SERVICE_USER=flipServiceAccount
XNAT_SERVICE_PASSWORD=flip
# XNAT stack passwords (Postgres + ActiveMQ). Minted into this kit by
# `make register-trust` (or `make generate-xnat-credentials`) — runtime-only
# secrets, never committed and never baked into the published XNAT image.
XNAT_DATASOURCE_PASSWORD=<run-make-generate-xnat-credentials>
XNAT_DATASOURCE_ADMIN_PASSWORD=<run-make-generate-xnat-credentials>
XNAT_ACTIVEMQ_PASSWORD=<run-make-generate-xnat-credentials>

# Internal trust-network URLs + service-auth header name. Kept in the kit
# because the fl-client also reads them from env; the trust
# APIs additionally default these in code, so they are robust if a kit omits them.
DATA_ACCESS_API_URL=http://data-access-api:8000
IMAGING_API_URL=http://imaging-api:8000
TRUST_INTERNAL_SERVICE_KEY_HEADER=X-Trust-Internal-Service-Key

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# ── Upstream PACS ─────────────────────────────────────────────────────────
# Defaults describe the mocked Orthanc that ships for development. A real trust points these at its
# PACS; see docs/source/components/component-pacs.rst.
#
# XNAT_AETITLE is XNAT's own AE title, applied to its DICOM SCP receiver, the DQR calling AE, and the
# C-MOVE destination handed to the PACS. It must match the AE title the PACS has registered for us,
# because the PACS opens the C-STORE association addressed to that title.
#
# PACS_QR_PORT is the port XNAT dials, and must be reachable *from the XNAT container* — not a
# host-published port. Getting that wrong is what the retired PACS_DICOM_PORT variable did
# (FLIP#822 / FLIP#862). (PACS_ID is read from XNAT at runtime as the sole registration; it remains only as the
# fallback for when XNAT is unreachable, and is not a kit field.)
XNAT_AETITLE=XNAT
PACS_HOST=orthanc
PACS_AETITLE=ORTHANC
PACS_QR_PORT=4242
PACS_LABEL=Test PACS instance

# PACS throttle. A production PACS may refuse further associations after a certain volume, and a
# trust may want retrieval confined to out-of-hours. Agree the window with the PACS manager.
PACS_AVAILABILITY_DAYS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY,SATURDAY,SUNDAY
PACS_AVAILABILITY_START=00:00
PACS_AVAILABILITY_END=24:00
PACS_THREADS=1
PACS_UTILIZATION_PERCENT=100
DQR_MAX_PACS_REQUEST_ATTEMPTS=100
DQR_RETRY_WAIT_SECONDS=300

# trust-api -> hub poll cadence (seconds).
POLL_INTERVAL_SECONDS=5

# Host-facing trust-API ports.
DATA_ACCESS_API_PORT=8010
IMAGING_API_PORT=8001
TRUST_API_PORT=8020

# Trust service log level.
TRUST_LOG_LEVEL=DEBUG

# fl-client capacity hints — describe THIS trust, not hub policy. NUM_AVAILABLE_GPUS
# also gates Docker GPU passthrough (>0 applies the gpu overlay); set 0 on a
# CPU-only host or `up` fails with "could not select device driver".
NUM_AVAILABLE_GPUS=1
MEMORY_PER_GPU_IN_GIB=7
MIN_CLIENTS=1

# Managed by `make register-trust` (initial fill: credentials + FL kit slot +
# hub-shared) and `make sync-trust-kit` (hub-shared refresh). Keep the
# hub-shared key list in lockstep with HUB_SHARED_KEYS in
# scripts/trust_kit_lib.py. The sentinel header below is matched byte-for-byte
# by the kit writer; do not edit.
# ── Hub-shared (managed by register-trust / sync-trust-kits — do not edit) ──
AES_KEY_BASE64=<run-make-register-trust>
CENTRAL_HUB_API_URL=<run-make-register-trust>
TRUST_API_KEY_HEADER=<run-make-register-trust>
FL_BACKEND=<run-make-register-trust>
FLOWER_KIT_DATE=<run-make-register-trust>
FLARE_KIT_DATE=<run-make-register-trust>
DOCKER_TAG=<run-make-register-trust>
DOCKER_REGISTRY=<run-make-register-trust>
DOCKER_FL_TAG=<run-make-register-trust>
DOCKER_FL_REGISTRY=<run-make-register-trust>
NLB_SUBDOMAIN=<run-make-register-trust>
FL_SERVER_PORT=<run-make-register-trust>

# ── Kit credentials (managed) ─────────────────────────────────────────────
# `make register-trust` upserts these. EXPECTED_TRUST_ID is an opt-in
# self-check: if the hub resolves this host's API key to a different trust id,
# trust-api exits instead of acting as the wrong trust.
TRUST_API_KEY=<run-make-register-trust>
TRUST_INTERNAL_SERVICE_KEY=<run-make-register-trust>
FL_KIT_SLOT=<run-make-register-trust>
FL_KIT_SLOT_NUMBER=<run-make-register-trust>
EXPECTED_TRUST_ID=<run-make-register-trust>
