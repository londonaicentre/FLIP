# Per-trust kit file for the on-prem ("local") trust.
#
# In a production deployment FLIP runs two trusts: one on an AWS EC2 host and
# one on-prem. "local" distinguishes the on-prem host from the EC2 host — it is
# a production concept. (Dev deployments do not use this: `make up` runs the
# Trust_1 and Trust_2 stacks instead.) The on-prem trust stack is brought up on
# its host by `make up-local-trust`, orchestrated by the hybrid deploy wrapper
# `make full-deploy-with-local-trust`.
#
# trust/Makefile selects this kit when LOCAL_TRUST_NAME=Trust_Local (the
# default in the root and deploy/providers/AWS Makefiles), which `-include`s
# trust/.env.Trust_Local. Copy this template to that path (drop the .example
# suffix):
#     cp trust/.env.Trust_Local.example trust/.env.Trust_Local
#
# Two parts, same shape as .env.Trust_1 / .env.Trust_2:
#   1. Host-local profile (ports, bind dirs) — unsuffixed names read by
#      LOCAL_TRUST_VARS in trust/Makefile. The values below are the local-trust
#      allocation, offset from the Trust_1/Trust_2 allocations so the on-prem
#      stack never clashes with a Trust_1/Trust_2 stack sharing the host. They
#      are also the defaults baked into LOCAL_TRUST_VARS, so a host could omit
#      them.
#   2. Kit credentials — minted by the hub. Fill in from `make register-trusts`
#      output or the Add-Trust modal (POST /admin/trusts shows the plaintext
#      once). The hub stores only the SHA-256 hash of TRUST_API_KEY.
#
# Unlike Trust_1/Trust_2 the local-trust stack does NOT expose trust-api /
# imaging-api / data-access-api on host ports (compose_trust.local.yml drops
# those bindings), so there are no *_DEBUG_PORT entries here.
#
# The real trust/.env.Trust_Local is gitignored (it holds plaintext secrets);
# this .example template is tracked.

# ── Host-local profile ────────────────────────────────────────────────────
OMOP_DB_PORT=5438
PACS_UI_PORT=8046
XNAT_PORT=8108
GRAFANA_PORT=3002
LOKI_PORT=3102
BASE_IMAGES_DOWNLOAD_DIR=./data/local/Trust_Local
ORTHANC_STORAGE_DIR=./orthanc/orthanc-storage-local
# Data dir for the on-prem trust's (mocked) omop-db. Override to point at an
# already-populated dir if this host has no seeded Trust_Local fixture.
OMOP_DATA_DIR=./omop-db/volumes/Trust_Local/db_data

# ── Trust-local credentials ──────────────────────────────────────────────
# Per-trust secrets the operator owns. In dev these are the same across
# Trust_1/Trust_2/Trust_Local for convenience. In prod each trust operator
# picks their own values. These are NOT in the hub's .env file — they live
# only in this kit file, so a remote trust operator can start their stack
# without needing the hub's environment.

# Orthanc (DICOM / PACS)
ORTHANC_USERNAME=<your-orthanc-username>
ORTHANC_PASSWORD=<your-orthanc-password>

# OMOP service account
OMOP_DB_SERVICE_NAME=omop-db
OMOP_POSTGRES_USER=postgres
OMOP_POSTGRES_PASSWORD=<your-omop-postgres-password>
OMOP_POSTGRES_DB=trustomopdb
OMOP_DB_TAG=latest

# OMOP read-only user used by data-access-api for cohort queries.
DATA_ACCESS_POSTGRES_USER=data_analyst_reader
DATA_ACCESS_POSTGRES_PASSWORD=<your-data-analyst-reader-password>

# XNAT admin + service account
XNAT_ADMIN_USER=<your-xnat-admin-username>
XNAT_ADMIN_INITIAL_PASSWORD=admin
XNAT_ADMIN_PASSWORD=<your-xnat-admin-password>
XNAT_SERVICE_USER=<your-xnat-service-account-username>
XNAT_SERVICE_PASSWORD=<your-xnat-service-account-password>
XNAT_DATABASE_URL=postgresql+asyncpg://xnat:xnat@xnat-db:5432/xnat

# Grafana
GRAFANA_ADMIN_PASSWORD=<your-grafana-admin-password>

# Service URLs internal to the trust Docker network (rarely overridden).
DATA_ACCESS_API_URL=http://data-access-api:8000
IMAGING_API_URL=http://imaging-api:8000
XNAT_URL=http://xnat-web:8080

# Trust-internal service-auth header name. Must match what trust-api,
# imaging-api, data-access-api, and fl-client all read.
TRUST_INTERNAL_SERVICE_KEY_HEADER=X-Trust-Internal-Service-Key

# PACS DICOM listening port + per-PACS index.
PACS_DICOM_PORT=4242
PACS_ID=1

# trust-api -> hub poll cadence (seconds).
POLL_INTERVAL_SECONDS=5

# Host-facing trust-API ports.
DATA_ACCESS_API_PORT=8010
IMAGING_API_PORT=8001
TRUST_API_PORT=8020

# Trust service log level.
TRUST_LOG_LEVEL=DEBUG

# fl-client capacity hints — these describe THIS trust, not hub policy.
NUM_AVAILABLE_GPUS=1
MEMORY_PER_GPU_IN_GIB=7
MIN_CLIENTS=1

# ── Kit credentials ───────────────────────────────────────────────────────
# EXPECTED_TRUST_ID is an opt-in self-check: if the hub resolves this host's
# API key to a different trust id, the trust-api exits instead of silently
# acting as the wrong trust.
#
# FL_KIT_SLOT names the provisioned FL participant kit the fl-client mounts
# (services/<slot>/ in the FLARE/Flower provisioning). FL kit slots are
# Trust_1, Trust_2, … — the on-prem trust is provisioned the Trust_2 slot, so
# FL_KIT_SLOT is fixed to Trust_2 here, distinct from this trust's own identity
# (Trust_Local) and its hub-side Trust.name.
TRUST_API_KEY=<from register-trusts / Add-Trust modal>
TRUST_INTERNAL_SERVICE_KEY=<from register-trusts / Add-Trust modal>
FL_KIT_SLOT=Trust_2
FL_KIT_SLOT_NUMBER=2
EXPECTED_TRUST_ID=<from register-trusts / Add-Trust modal>
