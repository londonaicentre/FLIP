# Prod-flavor kit template for the Trust_2 slot — the "on-prem" trust stack
# of a production deployment. In the FLIP prod environment Trust_2 is BDMS
# (see .env.production: TRUST_2_NAME=Trust_2 TRUST_2_CODE=BDMS
# TRUST_2_HOST=local). The dev-flavor sibling trust/.env.Trust_2.example
# keeps the dev-friendly defaults used by the regular `make up` flow.
#
# ── HOW THIS TEMPLATE IS USED ─────────────────────────────────────────────
# This file is the SOURCE template. The FLIP admin copies it to
# trust/.env.Trust_2 on their workstation and fills in the managed sections
# by hand:
#   1. UI → Add Trust → modal surfaces 5 KEY=VALUE lines (TRUST_API_KEY,
#      TRUST_INTERNAL_SERVICE_KEY, FL_KIT_SLOT, FL_KIT_SLOT_NUMBER,
#      EXPECTED_TRUST_ID). Paste them into the Kit credentials section
#      below, replacing the <run-make-register-trusts> placeholders.
#   2. `make sync-trust-kit KIT=Trust_2 PROD=true` (from repo root) populates
#      the Hub-shared block, replacing the <run-make-sync-trust-kit> placeholders.
# Then the admin runs `make package-onprem-trust-kit KIT=Trust_2` (from
# deploy/providers/AWS) which tarballs the populated kit file as-is + the
# operator's slice of the FL participant kit S3 bucket. The packager
# itself does not edit the kit file.
#
# An OPERATOR does NOT copy this file directly. They receive the populated
# `.env.Trust_2` (already produced by the admin) inside
# `flip-trust-kit-<slot>-<date>.tar.gz` and copy that into trust/.env.Trust_2.
# They then edit only the Host-local profile values to match their host
# (FL_KIT_DIR, ports, bind dirs) and optionally override Trust-local
# credentials for production-grade secrets.
#
# ── COEXISTING WITH A DEV STACK ON THE SAME LAPTOP ───────────────────────
# Two stacks named .env.Trust_2 (one dev, one prod-pointed) would collide
# on compose project name `trust2`. To run both on one host, the admin can
# pass NAME= to the packager and the operator places the starter under a
# distinct kit name:
#         cp ~/flip-trust-kit/.env.Trust_2 trust/.env.Trust_2_prod
#         make up-onprem-trust KIT=Trust_2_prod
# The prod-pointed stack then gets its own project (`trust2_prod`) + network
# (`deploy_trust-network-2_prod`) + named-volume prefix. The dev Trust_2
# keeps its own `.env.Trust_2` and `trust2` project.
#
# ── SECTIONS ──────────────────────────────────────────────────────────────
# Four sections, in order:
#   1. Host-local profile — unsuffixed ports / bind dirs read straight into
#      the compose stack. Operator-edited post-handoff. Defaults match the
#      LOCAL_TRUST_VARS allocation in trust/Makefile (non-overlapping with
#      the Trust_1 / Trust_2-dev allocations so a hybrid stack can coexist).
#   2. Trust-local credentials — Orthanc / OMOP / XNAT / Grafana passwords
#      and trust-internal service URLs. Operator-edited post-handoff. Never
#      leave the trust environment — the hub does not see these values.
#   3. Hub-shared (managed) — populated by `make sync-trust-kit KIT=<slot>`
#      (admin runs from repo root after registering the trust). Replaces the
#      <run-make-sync-trust-kit> placeholders. Do not hand-edit in either
#      this template or the operator copy.
#   4. Kit credentials (managed) — minted by the hub when register_trust
#      runs (via the UI Add-Trust modal). Admin pastes the 5 modal lines
#      into trust/.env.Trust_2, replacing the <run-make-register-trusts>
#      placeholders. Plaintext only survives in the admin's kit file +
#      the tarball + the operator's kit file; the hub keeps only SHA-256
#      hashes.
#
# The real trust/.env.Trust_2 is gitignored (it holds plaintext secrets);
# this .example template is tracked.

# ── Host-local profile ────────────────────────────────────────────────────
# Defaults match LOCAL_TRUST_VARS — non-overlapping with Trust_1 (5434/8042/
# 8104/3000/3100) and Trust_2 (5436/8044/8106/3001/3101) so all three stacks
# can coexist on one host during hybrid testing.
OMOP_DB_PORT=5438
PACS_UI_PORT=8046
XNAT_PORT=8108
TRUST_DEBUG_PORT=5688
IMAGING_DEBUG_PORT=5687
DATA_ACCESS_DEBUG_PORT=5686
GRAFANA_PORT=3002
LOKI_PORT=3102

# Dedicated `-local` Orthanc storage dir — do NOT point this at the same dir
# as the dev Trust_1 / Trust_2 stacks even to save the seeded DICOM gigabytes.
# Two Orthanc containers cannot open the same SQLite index; the second
# crash-loops on "database is locked" and breaks the trust network's
# `orthanc` alias (which xnat-nginx upstream resolution depends on). To
# re-seed locally on a dev laptop, one-shot copy from the matching trust dir:
#     cp -r trust/orthanc/orthanc-storage-trust1/ trust/orthanc/orthanc-storage-trust2-local/
ORTHANC_STORAGE_DIR=./orthanc/orthanc-storage-trust2-local
BASE_IMAGES_DOWNLOAD_DIR=./data/local/Trust_2
OMOP_DATA_DIR=./omop-db/volumes/Trust_2-local/db_data
# XNAT bind-mount parent dir. Relative paths resolve from trust/xnat/.
# In a real on-prem prod deployment, set this to the host path Ansible
# provisioned (typically /opt/flip/xnat). trust/xnat/Makefile resolves
# whatever you set here to an absolute path before exporting to docker
# compose.
XNAT_DATA_DIR=./xnat-data-trust2-local

# FL participant kit root on this host. The prod trust compose mounts
# ${FL_KIT_DIR}/net-1/services/${TRUST_NAME}/{local,startup,transfer}
# (nvflare) or ${FL_KIT_DIR}/net-1/{certificates,keys} (flower) — the
# net-1/ hierarchy mirrors the S3 bundle / dev workspace layout, so
# you extract or sync the kit *preserving* that structure.
#
# Default below matches the Ansible-managed location on an AWS EC2
# trust (/opt/flip/fl-kit). On-prem operators on a laptop typically
# override to somewhere under their home dir, e.g.:
#
#   FL_KIT_DIR=$HOME/flip-fl-kit
#
# `make up-onprem-trust KIT=<slot>` prints the per-backend selective
# `aws s3 sync` / `aws s3 cp` commands you (or the FLIP admin on your
# behalf) need to run to stage only your slot's portion of the kit
# under <FL_KIT_DIR>/net-1/... — never the whole net-1/ tree.
FL_KIT_DIR=/opt/flip/fl-kit

# Host paths / Docker named volumes for the observability stack. The
# trust/deploy/compose_trust.local.yml overlay declares the
# trust-local-loki-data / trust-local-grafana-data named volumes that these
# values reference — the compose_trust.production.yml base instead defaults
# to /opt/flip/volumes/{loki,grafana} bind mounts, so the on-prem flow
# overrides them here. Real on-prem prod operators on a dedicated host can
# flip these to the Ansible-provisioned /opt/flip/volumes/... paths instead.
OBSERVABILITY_CONFIG_DIR=./observability
LOKI_DATA_VOLUME=trust-local-loki-data
GRAFANA_DATA_VOLUME=trust-local-grafana-data

# TODO: remove once OMOP / Orthanc test-data fixtures are no longer pulled
# from the hub-side dev S3 bucket. trust/omop-db/update_omop_data.sh and
# trust/orthanc/update_orthanc_data.sh require AICENTRE_BUCKET_NAME; with
# the kit-file refactor the trust sub-make no longer inherits it from the
# hub .env.development, so we surface it here as a temporary opt-in.
AICENTRE_BUCKET_NAME=flipdev-aicentre

# ── Trust-local credentials ──────────────────────────────────────────────
# Per-trust secrets the operator owns. The defaults below are dev-friendly
# and identical across Trust_1 / dev Trust_2 / prod-pointed Trust_2 so a hybrid stack brings
# up without further editing. In a real on-prem prod deployment each
# operator must swap these for real secrets. These are NOT in the hub's
# .env file — they live only in this kit file, so a remote trust operator
# can start their stack without needing the hub's environment.

# Orthanc (DICOM / PACS)
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=admin

# OMOP service account
OMOP_DB_SERVICE_NAME=omop-db
OMOP_POSTGRES_USER=postgres
OMOP_POSTGRES_PASSWORD=omop
OMOP_POSTGRES_DB=trustomopdb
OMOP_DB_TAG=latest

# OMOP read-only user used by data-access-api for cohort queries.
DATA_ACCESS_POSTGRES_USER=data_analyst_reader
DATA_ACCESS_POSTGRES_PASSWORD=change_me_analyst_secure_password

# XNAT admin + service account
XNAT_ADMIN_USER=admin
XNAT_ADMIN_INITIAL_PASSWORD=admin
XNAT_ADMIN_PASSWORD=admin
XNAT_SERVICE_USER=flipServiceAccount
XNAT_SERVICE_PASSWORD=flip
XNAT_DATABASE_URL=postgresql+asyncpg://xnat:xnat@xnat-db:5432/xnat

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Service URLs internal to the trust Docker network (rarely overridden).
DATA_ACCESS_API_URL=http://data-access-api:8000
IMAGING_API_URL=http://imaging-api:8000
XNAT_URL=http://xnat-web:8080

# Trust-internal service-auth header name. Must match what trust-api,
# imaging-api, data-access-api, and fl-client all read.
TRUST_INTERNAL_SERVICE_KEY_HEADER=X-Trust-Internal-Service-Key

# PACS DICOM listening port + per-PACS index.
PACS_DICOM_PORT=4242
PACS_ID=1

# trust-api -> hub poll cadence (seconds).
POLL_INTERVAL_SECONDS=5

# Host-facing trust-API ports. Shifted off Trust_1's defaults (8010/8001/8020)
# so a Trust_2-prod stack can coexist with a co-located dev Trust_1 on the
# same laptop without colliding. A real on-prem operator running just one
# trust on a dedicated host can revert these to 8010/8001/8020 if standard
# ports are preferred for tooling.
DATA_ACCESS_API_PORT=8014
IMAGING_API_PORT=8005
TRUST_API_PORT=8024

# Trust service log level.
TRUST_LOG_LEVEL=DEBUG

# fl-client capacity hints — these describe THIS trust, not hub policy.
# NUM_AVAILABLE_GPUS also gates Docker GPU passthrough: when > 0, trust/Makefile
# applies the compose_trust.<env>.gpu.yml overlay so the fl-client reserves that
# many host NVIDIA GPUs (requires the NVIDIA Container Toolkit on the host). Set it
# to 0 on a CPU-only host — e.g. the AWS EC2 t3.xlarge test trust — or `up` fails
# with "could not select device driver ... [[gpu]]". MEMORY_PER_GPU_IN_GIB applies
# only when GPUs > 0.
NUM_AVAILABLE_GPUS=1
MEMORY_PER_GPU_IN_GIB=7
MIN_CLIENTS=1

# Hub-shared block. In the on-prem flow the FLIP admin's
# `make package-onprem-trust-kit KIT=Trust_2` command overwrites these
# placeholders with values minted by register_trust running on the prod
# hub. Keep the key list in lockstep with HUB_SHARED_ENV_KEYS in
# flip_api/scripts/register_trust.py.
#
# `<run-make-sync-trust-kit>` means register/sync has not populated this
# kit yet; the trust stack will refuse to start until it is filled in.
# The header line below is a sentinel — distribute-trust-kits.sh,
# sync-trust-kits.sh, and package-onprem-trust-kit.sh all grep for it
# byte-for-byte; do not edit.
# ── Hub-shared (managed by register-trust / sync-trust-kits — do not edit) ──
AES_KEY_BASE64=<run-make-sync-trust-kit>
CENTRAL_HUB_API_URL=<run-make-sync-trust-kit>
TRUST_API_KEY_HEADER=<run-make-sync-trust-kit>
FL_BACKEND=<run-make-sync-trust-kit>
FLARE_KIT_DATE=<run-make-sync-trust-kit>
FLOWER_KIT_DATE=<run-make-sync-trust-kit>
DOCKER_TAG=<run-make-sync-trust-kit>
DOCKER_REGISTRY=<run-make-sync-trust-kit>
DOCKER_FL_TAG=<run-make-sync-trust-kit>
DOCKER_FL_REGISTRY=<run-make-sync-trust-kit>
NLB_SUBDOMAIN=<run-make-sync-trust-kit>
FL_SERVER_PORT=<run-make-sync-trust-kit>

# ── Kit credentials (managed) ─────────────────────────────────────────────
# The hub mints these on trust registration. For the UI Add-Trust flow,
# copy them from the modal (which surfaces them once). For the
# `make register-trusts` flow they're written automatically.
# EXPECTED_TRUST_ID is an opt-in self-check: if the hub later resolves
# this host's API key to a different trust id, trust-api exits at startup
# instead of silently acting as the wrong trust.
TRUST_API_KEY=<run-make-register-trusts>
TRUST_INTERNAL_SERVICE_KEY=<run-make-register-trusts>
FL_KIT_SLOT=<run-make-register-trusts>
FL_KIT_SLOT_NUMBER=<run-make-register-trusts>
EXPECTED_TRUST_ID=<run-make-register-trusts>
