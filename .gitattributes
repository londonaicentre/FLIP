# fl-apps/<backend>/required_files.json is generated by fl-apps/check_required_files.sh from each
# backend's per-template required_files.json arrays — do not hand-edit it (edit the per-template
# files instead; the pre-commit hook + CI drift-guard regenerate and will revert manual changes).
# Marked generated so GitHub collapses it in diffs and flags it as derived. The pattern matches only
# the per-backend aggregate (single path segment after fl-apps/), never the per-template sources.
fl-apps/*/required_files.json linguist-generated=true

# The NVFLARE base app configs (standard, evaluation, fed_opt, diffusion_model) are generated from
# flip.nvflare.recipes (FlipFedAvgRecipe / FlipEvalRecipe / FlipFedOptRecipe / FlipDiffusionRecipe)
# by each template's recipe.py — do not hand-edit; regenerate after any recipe change (see each
# template's README) and commit the result.
# Marked generated so GitHub collapses them in diffs and flags them as derived.
fl-apps/nvflare/*/app/config/config_fed_server.json linguist-generated=true
fl-apps/nvflare/*/app/config/config_fed_client.json linguist-generated=true
fl-apps/nvflare/*/meta.json linguist-generated=true

# fl-tutorials/datasets/utils/schemas/*.yaml are Pandera's own serialisation (pandera.io.to_yaml) of
# schemas derived from the official OMOP CDM 5.4 PostgreSQL DDL — do not hand-edit; regenerate with
# `python fl-tutorials/datasets/utils/omop_schemas.py --regenerate` after bumping DDL_URL, and commit
# the result. They carry no Apache header because pandera writes the file and would drop one on every
# regenerate; marking them generated is the same treatment the aggregates above get, and records that
# the licence rule applies to the generator rather than to its output.
fl-tutorials/datasets/utils/schemas/*.yaml linguist-generated=true
