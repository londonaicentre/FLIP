    {
      "username": "service-account-flip-api-admin",
      "enabled": true,
      "serviceAccountClientId": "flip-api-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-clients"]
      }
    }
  ]
}
