# What a compose trust needs to run its upgrade verb, and nothing else (FLIP#1753).
# One pattern per line, relative to the repo root. A trailing slash takes a directory and
# everything under it; `*` stays inside one directory and `**` crosses them; a leading `!`
# excludes. A pattern that matches no tracked file fails the build, so a rename breaks
# packaging rather than silently leaving a file out of the release.
# scripts/package_compose_bundle.py reads this file; scripts/tests/test_package_compose_bundle.py
# unpacks the result with no .git and checks that `make -n upgrade-onprem-trust` still parses.

# The Makefile chain `make upgrade-onprem-trust` parses.
Makefile
deploy/env_mode.mk
deploy/fl_backend.mk
deploy/instance.mk
deploy/portable.mk
trust/Makefile

# The stack it brings up, and the config the stack mounts from the host.
trust/deploy/compose/
trust/observability/
trust/governance.example.toml
# XNAT's own Makefile and stack, which upgrade-trust drives with `make -C xnat`. Its .env is
# tracked public defaults (versions, heap, paths), allowed by PUBLIC_ENV_FILES in the packager.
trust/xnat/
!trust/xnat/tests

# The scripts the verb and the auto-upgrade agent call.
trust/deploy/scripts/
!trust/deploy/scripts/tests
scripts/trust_upgrade_agent.py
scripts/setup_auto_upgrade.py
