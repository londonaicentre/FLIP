# Account-specific configuration for the e2e-lza stack.
#   cp .env.e2e.example .env.e2e   # then fill in — .env.e2e is gitignored.
# Every value here targets the LZA workload account (FLIPProduction, or a
# future test account cut from the same Workloads/Prod VPC template). Never
# point any of them at the legacy prod/stag/dev accounts — the Makefile
# refuses those profiles.

# Identity Center profile for the LZA workload account (aws configure sso).
# If your local profile name differs, also set E2E_AWS_PROFILE to match.
AWS_PROFILE=FLIPAdminAccess-893493035022

AWS_REGION=eu-west-2

# S3 bucket (in the workload account) holding Terraform state. The LZA
# account already carries flip-terraform-state-lza (created out-of-band for
# the migration work); `make create-backend` creates it if missing. State
# key is flip/e2e-lza/terraform.tfstate (see backend.tf).
FLIP_TFSTATE_BUCKET_NAME=flip-terraform-state-lza

# Web leg (internal ALB + e2e-web). Leave unset/false until the multi-AZ
# subnet change lands in londonaicentre/lza — an ALB needs >= 2 AZs and the
# prod VPC template is single-AZ today (README open question 2).
# TF_VAR_enable_web_leg=true

# Phase B only: CIDRs of the networking-account ingress VPC subnets (value
# comes from the networking-account owner). JSON list, NO spaces — make's
# env-file parsing does not survive them. Leave commented for Phase A.
# TF_VAR_networking_ingress_cidrs=["10.100.0.0/24","10.100.1.0/24"]
