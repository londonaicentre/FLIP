# Account-specific configuration for the e2e-lza stack.
#   cp .env.e2e.example .env.e2e   # then fill in — .env.e2e is gitignored.
# Every value here targets the NEW sealed LZA workload account. Do NOT point
# any of them at the FLIP-Prod, staging, networking, or dev accounts.

# AWS CLI profile for the e2e LZA workload account (aws configure sso).
# The Makefile refuses to run with the dev/stag/prod profiles.
AWS_PROFILE=

AWS_REGION=eu-west-2

# S3 bucket (in the workload account) holding Terraform state. Created by
# `make create-backend` if it does not exist yet. State key is
# flip/e2e-lza/terraform.tfstate (see backend.tf).
FLIP_TFSTATE_BUCKET_NAME=

# PLACEHOLDER — the VPC CIDR must be allocated from the LZA IPAM and must not
# overlap the TGW route domain. Get sign-off from the networking-account
# owner BEFORE `make apply` (README open question 1).
TF_VAR_vpc_cidr=10.255.0.0/16

# Phase B only: CIDRs of the networking-account ingress VPC subnets (value
# comes from the networking-account owner). JSON list, NO spaces — make's
# env-file parsing does not survive them. Leave commented for Phase A.
# TF_VAR_networking_ingress_cidrs=["10.100.0.0/24","10.100.1.0/24"]
