# Copied to backend.tf (gitignored) by `make migrate-state`, once the first apply
# has created the state bucket. Kept out of the committed root so the first apply
# can run on local state: the bucket does not exist until then.
#
# Its own key, separate from the FLIP root's flip/terraform.tfstate, so the
# pipeline those roles authorise never manages its own credentials: an apply that
# broke them would otherwise lock CI out of the apply that fixes them.
#
# bucket and region come from `-backend-config` at init time.

terraform {
  backend "s3" {
    key          = "flip/ci/terraform.tfstate"
    encrypt      = true
    use_lockfile = true
  }
}
