# Copy to terraform.tfvars (gitignored), one per account, and fill in.
# `make plan TFVARS=prod.tfvars` selects another file.

aws_region          = "eu-west-2"
allowed_account_ids = ["123456789012"] # the ONE account this bootstrap is for

# Your fork or copy of FLIP — never londonaicentre/FLIP, or your roles would
# trust AI Centre's workflows.
github_org  = "your-org"
github_repo = "FLIP"

# Staging: environment = "stag", github_environment = "aws-stag", apply_branch = "develop"
# Production: environment = "prod", github_environment = "aws-prod", apply_branch = "main",
#             drift_branch = "main"
environment        = "stag"
github_environment = "aws-stag"
apply_branch       = "develop"

# Globally unique. The FLIP root's FLIP_TFSTATE_BUCKET_NAME must name the same bucket.
state_bucket_name = "your-org-flip-terraform-state-stag"
