# EXAMPLE ONLY — every value here is a placeholder.
#
# The real file is GENERATED, never hand-written and never committed:
#
#     scripts/generate_values.py --env-file trust/.env.<CODE>.<env>
#
# It is written with mode 0600 and .gitignore'd, because it carries live trust
# credentials. Copy this file only as a field reference.
#
# Two fields must never be given the same value as their sibling:
# data-access-postgres-password vs omop-postgres-password, and
# xnat-service-password vs xnat-admin-password. The xnat-db entrypoint refuses
# to start if the XNAT pair matches.
secrets:
  create: True
  data:
    aes-key-base64: "<generate: openssl rand -base64 32>"
    trust-internal-service-key-header: X-Trust-Internal-Service-Key
    trust-internal-service-key: "<from trust/.env.<CODE>.<env>: TRUST_INTERNAL_SERVICE_KEY>"
    trust-api-key: "<from trust/.env.<CODE>.<env>: TRUST_API_KEY>"
    omop-postgres-password: "<generate: openssl rand -base64 24>"
    data-access-postgres-password: "<generate: openssl rand -base64 24 — MUST differ from omop-postgres-password>"
    orthanc-registered-users: '{"admin": "admin"}'
    xnat-admin-password: "<run-make-generate-xnat-credentials>"
    # Never a literal here (FLIP-PT-056): mint into the trust kit with
    # `make generate-xnat-credentials KIT=<CODE>` and fill via
    # `scripts/generate_values.py --env-file trust/.env.<CODE>.<env>`.
    # xnat-web's entrypoint refuses to start on this placeholder or any
    # known-weak value.
    #
    # Two distinct credentials: the `xnat` application role, and the Postgres
    # superuser (xnat-db's POSTGRES_PASSWORD). The xnat-db entrypoint refuses to
    # start if they are ever wired to the same value.
    xnat-datasource-password: "<run-make-generate-xnat-credentials>"
    xnat-datasource-admin-password: "<run-make-generate-xnat-credentials>"
    xnat-service-user: "<from trust/.env.<CODE>.<env>: XNAT_SERVICE_USER>"
    xnat-service-password: "<run-make-generate-xnat-credentials — MUST differ from xnat-admin-password>"
    grafana-admin-password: "<generate: openssl rand -base64 24>"
    s3-access-key-id: dummy
    s3-secret-access-key: dummy
    aws-session-token: dummy
