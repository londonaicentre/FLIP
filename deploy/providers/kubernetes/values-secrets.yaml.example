# EXAMPLE ONLY — a field reference. Every slot is deliberately EMPTY.
#
# The real file is GENERATED, never hand-written and never committed. From the
# repo root:
#
#     python3 deploy/providers/kubernetes/scripts/generate_values.py \
#         --env-file trust/.env.<CODE>.<env> \
#         --output-dir deploy/providers/kubernetes
#
# It is written with mode 0600 and matched by the repo's `**/values-secrets.yaml`
# ignore rule wherever it lands, because it carries live trust credentials.
#
# Why the slots are empty rather than placeholder strings: templates/secrets.yaml
# guards every key with `if index`, so an empty slot is omitted from the Secret
# and the pod that mounts it dies at container creation with
# CreateContainerConfigError. Copying this file into place therefore fails loud
# instead of deploying a service on a published literal — the same pattern
# values.yaml already documents for orthanc-registered-users. Fill a slot only in
# the generated file, never here.
#
# One slot the generator CANNOT fill — no trust kit carries the source env var,
# so it needs hand-filling in the generated file before a deploy:
#   orthanc-registered-users  (required when orthanc.enabled)
#
# There are no AWS slots: the fl-client holds no AWS credentials and never fetches
# its own kit (FLIP#965). Stage the kit onto the node with `make stage-kit` and
# point flClient.kitHostPath at it.
#
# Two pairs must never be given the same value:
#   data-access-postgres-password  vs  omop-postgres-password
#   xnat-datasource-password       vs  xnat-datasource-admin-password
# The second is the pair the xnat-db entrypoint enforces: it refuses to start
# when the `xnat` application role's password (XNAT_DATASOURCE_PASSWORD) equals
# the Postgres superuser's (POSTGRES_PASSWORD), which would make the app role
# superuser-equivalent (FLIP-PT-056).
secrets:
  create: True
  data:
    # openssl rand -base64 32
    aes-key-base64: ""
    # trust/.env.<CODE>.<env>: TRUST_INTERNAL_SERVICE_KEY_HEADER
    # (X-Trust-Internal-Service-Key)
    trust-internal-service-key-header: ""
    # trust/.env.<CODE>.<env>: TRUST_INTERNAL_SERVICE_KEY
    trust-internal-service-key: ""
    # trust/.env.<CODE>.<env>: TRUST_API_KEY
    trust-api-key: ""
    # openssl rand -base64 24
    omop-postgres-password: ""
    # openssl rand -base64 24 — MUST differ from omop-postgres-password
    data-access-postgres-password: ""
    # JSON user map, e.g. {"admin": "<password>"}. No kit env var maps to this —
    # hand-fill it in the generated file, or orthanc fails to start.
    orthanc-registered-users: ""
    # XNAT credentials: mint into the trust kit with
    # `make generate-xnat-credentials KIT=<CODE>`, then let generate_values.py
    # copy them across. xnat-web and xnat-db refuse to start on a known-weak or
    # placeholder value, so never write a literal here.
    xnat-admin-password: ""
    # Password of the `xnat` application role (XNAT_DATASOURCE_PASSWORD).
    xnat-datasource-password: ""
    # Password of the Postgres superuser (xnat-db's POSTGRES_PASSWORD).
    # MUST differ from xnat-datasource-password.
    xnat-datasource-admin-password: ""
    # trust/.env.<CODE>.<env>: XNAT_SERVICE_USER
    xnat-service-user: ""
    # trust/.env.<CODE>.<env>: XNAT_SERVICE_PASSWORD
    xnat-service-password: ""
    # openssl rand -base64 24
    grafana-admin-password: ""
